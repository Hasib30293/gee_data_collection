# Google Earth Engine Project Configuration
GEE_PROJECT_ID=ee-yourusername

# Google Drive Export Settings
GOOGLE_DRIVE_FOLDER=GEE_Exports

# Area of Interest (AOI) - Bangladesh Example
AOI_MIN_LONGITUDE=88.0
AOI_MIN_LATITUDE=20.0
AOI_MAX_LONGITUDE=92.5
AOI_MAX_LATITUDE=26.5

# Collection Parameters
START_DATE=2023-01-01
END_DATE=2023-12-31
CLOUD_COVER_THRESHOLD=20
MAX_IMAGES=50

# Export Parameters
EXPORT_SCALE=10
EXPORT_CRS=EPSG:4326
EXPORT_FORMAT=GeoTIFF

# Image Collection
SATELLITE_DATASET=COPERNICUS/S2_SR_HARMONIZED

# Visualization
VIS_SCALE=10
VIS_GAMMA=1.2
